# Chave de API do Google Gemini (IA Generativa para o Stylist)
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Chave de API para Remoção de Fundo (Ex: remove.bg ou Photoroom)
# Obtenha em: https://www.remove.bg/api ou https://www.photoroom.com/api
# Deixe vazio para usar o processador de imagem local inteligente/mock
REMOVE_BG_API_KEY=YOUR_REMOVE_BG_API_KEY_HERE
REMOVE_BG_API_URL=https://api.remove.bg/v1.0/removebg

# ========================================================
